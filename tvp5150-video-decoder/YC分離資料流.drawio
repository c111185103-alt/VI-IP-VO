<mxfile host="Electron">
  <diagram name="YC Separation" id="tvp5150_yc_sep_0001">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1650" pageHeight="450" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="TITLE" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;" value="Y/C 分離資料流(對應資料手冊 3.2~3.6 節)" vertex="1">
          <mxGeometry height="40" width="600" x="20" y="10" as="geometry" />
        </mxCell>

        <mxCell id="IN" parent="1" style="whiteSpace=wrap;html=1;verticalAlign=middle;align=center;rounded=1;fillColor=light-dark(#FFFFFF,#2E2E2E);fontSize=16;" value="複合視訊 (Composite)&#10;或已分離之 luma/chroma" vertex="1">
          <mxGeometry height="80" width="180" x="20" y="170" as="geometry" />
        </mxCell>

        <mxCell id="QDEMOD" parent="1" style="whiteSpace=wrap;html=1;verticalAlign=middle;align=center;rounded=1;fillColor=light-dark(#FFFFFF,#1F4B46);fontSize=16;" value="Quadrature&#10;Demodulator" vertex="1">
          <mxGeometry height="70" width="170" x="260" y="60" as="geometry" />
        </mxCell>
        <mxCell id="LPF" parent="1" style="whiteSpace=wrap;html=1;verticalAlign=middle;align=center;rounded=1;fillColor=light-dark(#FFFFFF,#1F4B46);fontSize=16;" value="Color LPF ↓2" vertex="1">
          <mxGeometry height="70" width="170" x="490" y="60" as="geometry" />
        </mxCell>
        <mxCell id="COMB" parent="1" style="whiteSpace=wrap;html=1;verticalAlign=middle;align=center;rounded=1;fillColor=light-dark(#FFFFFF,#1F4B46);fontSize=16;" value="4-line Adaptive&#10;Comb Filter" vertex="1">
          <mxGeometry height="70" width="190" x="720" y="60" as="geometry" />
        </mxCell>
        <mxCell id="NOTCH" parent="1" style="whiteSpace=wrap;html=1;verticalAlign=middle;align=center;rounded=1;fillColor=light-dark(#FFFFFF,#1F4B46);fontSize=16;" value="Notch / LP Filter" vertex="1">
          <mxGeometry height="70" width="170" x="970" y="60" as="geometry" />
        </mxCell>
        <mxCell id="CBCR" parent="1" style="whiteSpace=wrap;html=1;verticalAlign=middle;align=center;rounded=1;fillColor=light-dark(#FFFFFF,#40245B);fontSize=16;fontStyle=1;" value="Cb, Cr" vertex="1">
          <mxGeometry height="70" width="120" x="1200" y="60" as="geometry" />
        </mxCell>

        <mxCell id="REMOD" parent="1" style="whiteSpace=wrap;html=1;verticalAlign=middle;align=center;rounded=1;fillColor=light-dark(#FFFFFF,#1F4B46);fontSize=16;" value="重調變&#10;(Quadrature Mod)" vertex="1">
          <mxGeometry height="70" width="190" x="720" y="200" as="geometry" />
        </mxCell>

        <mxCell id="LDELAY" parent="1" style="whiteSpace=wrap;html=1;verticalAlign=middle;align=center;rounded=1;fillColor=light-dark(#FFFFFF,#5C3812);fontSize=16;" value="Line Delay" vertex="1">
          <mxGeometry height="70" width="170" x="260" y="330" as="geometry" />
        </mxCell>
        <mxCell id="SUB" parent="1" style="whiteSpace=wrap;html=1;verticalAlign=middle;align=center;rounded=1;fillColor=light-dark(#FFFFFF,#5C3812);fontSize=20;fontStyle=1;" value="－" vertex="1">
          <mxGeometry height="70" width="90" x="510" y="330" as="geometry" />
        </mxCell>
        <mxCell id="PEAK" parent="1" style="whiteSpace=wrap;html=1;verticalAlign=middle;align=center;rounded=1;fillColor=light-dark(#FFFFFF,#5C3812);fontSize=16;" value="Peaking&#10;(Sharpness)" vertex="1">
          <mxGeometry height="70" width="170" x="720" y="330" as="geometry" />
        </mxCell>
        <mxCell id="Y" parent="1" style="whiteSpace=wrap;html=1;verticalAlign=middle;align=center;rounded=1;fillColor=light-dark(#FFFFFF,#40245B);fontSize=16;fontStyle=1;" value="Y" vertex="1">
          <mxGeometry height="70" width="120" x="970" y="330" as="geometry" />
        </mxCell>

        <mxCell id="ADJ" parent="1" style="whiteSpace=wrap;html=1;verticalAlign=middle;align=center;rounded=1;fillColor=light-dark(#FFFFFF,#2E2E2E);fontSize=16;" value="Contrast / Brightness&#10;/ Saturation / Hue" vertex="1">
          <mxGeometry height="90" width="200" x="1200" y="195" as="geometry" />
        </mxCell>
        <mxCell id="OUT" parent="1" style="whiteSpace=wrap;html=1;verticalAlign=middle;align=center;rounded=1;fillColor=light-dark(#FFFFFF,#1F4B46);fontSize=16;fontStyle=1;" value="送到輸出格式器&#10;(Output Formatter)" vertex="1">
          <mxGeometry height="90" width="180" x="1450" y="195" as="geometry" />
        </mxCell>

        <!-- input splits into chroma path and luma path -->
        <mxCell id="e1" edge="1" parent="1" source="IN" target="QDEMOD" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=13;" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" edge="1" parent="1" source="IN" target="LDELAY" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=13;" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- chroma path -->
        <mxCell id="e3" edge="1" parent="1" source="QDEMOD" target="LPF" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=13;" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" edge="1" parent="1" source="LPF" target="COMB" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=13;" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" edge="1" parent="1" source="COMB" target="NOTCH" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=13;" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" edge="1" parent="1" source="NOTCH" target="CBCR" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=13;" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- comb filter output feeds back down to remodulation -->
        <mxCell id="e7" edge="1" parent="1" source="COMB" target="REMOD" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontSize=13;" value="回饋">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- remodulated chroma feeds into subtractor -->
        <mxCell id="e8" edge="1" parent="1" source="REMOD" target="SUB" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontSize=13;" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- luma path -->
        <mxCell id="e9" edge="1" parent="1" source="LDELAY" target="SUB" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=13;" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e10" edge="1" parent="1" source="SUB" target="PEAK" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=13;" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e11" edge="1" parent="1" source="PEAK" target="Y" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=13;" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Y, Cb, Cr merge into adjust block -->
        <mxCell id="e12" edge="1" parent="1" source="CBCR" target="ADJ" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;fontSize=13;" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e13" edge="1" parent="1" source="Y" target="ADJ" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;fontSize=13;" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e14" edge="1" parent="1" source="ADJ" target="OUT" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=13;" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
